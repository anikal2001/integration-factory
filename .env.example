# Copy to .env. Every CLI reads .env from the working directory (plus EXTRA_ENV_FILE).
# Nothing below is required for `npm run demo`.

# ── Model gateway (provider-agnostic) ────────────────────────────────────────
# Leave MODEL_API_KEY unset to run the offline MockModel (scripted, no network).
# Any OpenAI-compatible /chat/completions endpoint works — swap by changing these:
#   OpenRouter: MODEL_BASE_URL=https://openrouter.ai/api/v1   MODEL_NAME=anthropic/claude-sonnet-4.5
#   Anthropic:  MODEL_BASE_URL=https://api.anthropic.com/v1   MODEL_NAME=claude-sonnet-4-5
#   OpenAI:     MODEL_BASE_URL=https://api.openai.com/v1      MODEL_NAME=gpt-4.1
#   LiteLLM:    MODEL_BASE_URL=http://localhost:4000/v1       MODEL_NAME=<your-alias>
#   Ollama:     MODEL_BASE_URL=http://localhost:11434/v1      MODEL_NAME=qwen2.5-coder
# MODEL_BASE_URL=
# MODEL_API_KEY=
# MODEL_NAME=
# MAX_STEPS=12

# ── Sandbox backend (provider-agnostic) ──────────────────────────────────────
# local (default): a git worktree of TARGET_REPO — no cloud creds needed.
# daytona: cloud sandbox (experimental; needs a key; TARGET_REPO must be a git URL).
SANDBOX_PROVIDER=local
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://api.daytona.io

# ── Target repo (the codebase receiving the integration) ─────────────────────
# Must contain integration-factory.json (see examples/sample-target-repo).
# TARGET_REPO=../my-backend
# BASE_REF=origin/main          # overrides the profile's baseRef
# VERIFY_CMD=npm run build      # overrides the profile's verify command
# PROFILE=path/to/profile.json  # overrides <TARGET_REPO>/integration-factory.json
# OPEN_PR=true                  # actually push + open the PR (default: dry-run)
# PR_BASE_REF=origin/main       # onboard PR base

# ── Browser discovery ────────────────────────────────────────────────────────
# local (default): local Chromium (`npx playwright install chromium` once).
# browserbase: cloud Chromium over CDP. Needs a key + project id.
BROWSER_PROVIDER=local
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_PROXIES=false

# Credentials for automated (headless) login to an account YOU control. Headed login
# (the default) lets a human finish the flow instead, and these can stay unset.
# TARGET_EMAIL=
# TARGET_PASSWORD=
# Mailbox (app password, not the site password) so an emailed code can be read.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_APP_PASSWORD=
# IMAP_FROM=

# Optional residential proxy for targets that permit it. A CAPTCHA still needs a human.
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=

# Optional one-action visual adviser (Browser Use). Off unless --visual is passed.
# BROWSER_USE_API_KEY=
# BROWSER_USE_MODEL=bu-2-0
